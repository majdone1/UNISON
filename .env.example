# UNISON environment template — copy to .env and fill locally.
# Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
NEXT_PUBLIC_APP_NAME=UNISON
DEMO_MODE=true

# Supabase — project name must be unison-production ONLY.
# Keep DEMO_MODE=true for local/CI. Set DEMO_MODE=false only after migrations applied.
# Fill locally / in host secrets — never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database (optional direct connection for migrations)
DATABASE_URL=

# Billing (mock provider used when unset)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# File storage
STORAGE_BUCKET=attachments

# Security
RATE_LIMIT_ENABLED=true
CSP_ENABLED=true

# Desktop deep links
DESKTOP_DEEP_LINK_SCHEME=unison

# Mobile push (BLOCKED_EXTERNAL)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:43127
