{
  "name": "@unison/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 43128",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "node -e \"const fs=require('fs'); JSON.parse(fs.readFileSync('app.json','utf8')); console.log('mobile lint ok')\"",
    "typecheck": "tsc --noEmit",
    "test": "echo 'mobile tests placeholder'",
    "build": "tsc --noEmit && echo 'Use EAS for native builds — see docs/MOBILE_RELEASE.md'",
    "ci:validate": "node ../../scripts/ci-validate-mobile.mjs"
  },
  "dependencies": {
    "@unison/shared": "workspace:*",
    "@unison/types": "workspace:*",
    "expo": "~52.0.39",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.8.2"
  }
}
