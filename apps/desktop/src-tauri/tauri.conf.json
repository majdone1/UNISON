{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNISON",
  "version": "0.1.0",
  "identifier": "com.unison.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @unison/web dev",
    "devUrl": "http://127.0.0.1:43127",
    "beforeBuildCommand": "pnpm --filter @unison/web build",
    "frontendDist": "../../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "UNISON",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:43127 https://*.supabase.co wss://*.supabase.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["unison"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
